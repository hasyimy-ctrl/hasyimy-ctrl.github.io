CACHE MANIFEST
# version: 2025-01-lapse-systest-v3
#
# BUMP THIS LINE every time any cached file changes. The HTML5 App Cache
# only re-fetches when THIS manifest is itself different, so editing
# src/lapse.js (or any CACHE: entry) WITHOUT touching this line leaves the
# console running the OLD file from cache -- which is exactly why a fixed
# lapse.js kept "freezing at the same place" on device. One character
# change here is what pushes the new file.

CACHE:
index.html
includes/style.css
includes/script.js
includes/image.jpg
src/core.js
src/mem.js
src/int64.js
src/offset.js
src/main.js
src/lapse.js
src/netctrl.js
src/check-jailbroken.js
src/post-exploit.js
src/module/addr.js
src/module/assets.js
src/module/constants.js
src/module/syscall.js
src/module/log.js
src/module/reporter.js
src/module/rop.js
src/module/gadgets.js
src/worker.js
src/workers.js
src/kpatch/1000.bin
src/kpatch/1050.bin
src/kpatch/1100.bin
src/kpatch/1102.bin
src/kpatch/1150.bin
src/kpatch/1200.bin
src/kpatch/1250.bin
src/kpatch/1300.bin
src/goldhen.bin
src/hen.bin
# payload.bin is DELIBERATELY NOT listed. It is optional (the "Custom" option
# appears only when it is present), and a CACHE: entry that 404s makes the
# browser reject the ENTIRE manifest -- nothing gets cached at all. It falls
# under NETWORK: * below, so the page still fetches it when it exists.
NETWORK:
*
